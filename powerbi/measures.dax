// Measures used by the embedded semantic model.

Observations = COUNTROWS(warehouse_daily)

Discrepancy Records = COUNTROWS(FILTER(warehouse_daily, warehouse_daily[variance] <> 0))

Demand Fulfillment = DIVIDE(SUM(warehouse_daily[shipped]), SUM(warehouse_daily[demand]), 0)

Total Demand = SUM(warehouse_daily[demand])

Total Shipped = SUM(warehouse_daily[shipped])

Reorder Alerts = CALCULATE(COUNTROWS(replenishment_recommendations), replenishment_recommendations[reorder_alert] = TRUE())

Proposed Units = SUM(replenishment_recommendations[recommended_order_qty])

