{
  "name": "Warehouse",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "warehouse_daily",
        "columns": [
          {
            "name": "warehouse",
            "dataType": "string",
            "sourceColumn": "warehouse",
            "summarizeBy": "none"
          },
          {
            "name": "sku",
            "dataType": "string",
            "sourceColumn": "sku",
            "summarizeBy": "none"
          },
          {
            "name": "day",
            "dataType": "int64",
            "sourceColumn": "day",
            "summarizeBy": "none"
          },
          {
            "name": "opening_stock",
            "dataType": "int64",
            "sourceColumn": "opening_stock",
            "summarizeBy": "none"
          },
          {
            "name": "received",
            "dataType": "int64",
            "sourceColumn": "received",
            "summarizeBy": "none"
          },
          {
            "name": "demand",
            "dataType": "int64",
            "sourceColumn": "demand",
            "summarizeBy": "none"
          },
          {
            "name": "shipped",
            "dataType": "int64",
            "sourceColumn": "shipped",
            "summarizeBy": "none"
          },
          {
            "name": "erp_stock",
            "dataType": "int64",
            "sourceColumn": "erp_stock",
            "summarizeBy": "none"
          },
          {
            "name": "wms_stock",
            "dataType": "int64",
            "sourceColumn": "wms_stock",
            "summarizeBy": "none"
          },
          {
            "name": "variance",
            "dataType": "int64",
            "sourceColumn": "variance",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "warehouse_daily",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"warehouse\", type text}, {\"sku\", type text}, {\"day\", Int64.Type}, {\"opening_stock\", Int64.Type}, {\"received\", Int64.Type}, {\"demand\", Int64.Type}, {\"shipped\", Int64.Type}, {\"erp_stock\", Int64.Type}, {\"wms_stock\", Int64.Type}, {\"variance\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Observations",
            "expression": "COUNTROWS(warehouse_daily)",
            "formatString": "#,0"
          },
          {
            "name": "Discrepancy Records",
            "expression": "COUNTROWS(FILTER(warehouse_daily, warehouse_daily[variance] <> 0))",
            "formatString": "#,0"
          },
          {
            "name": "Demand Fulfillment",
            "expression": "DIVIDE(SUM(warehouse_daily[shipped]), SUM(warehouse_daily[demand]), 0)",
            "formatString": "0.00%"
          },
          {
            "name": "Total Demand",
            "expression": "SUM(warehouse_daily[demand])",
            "formatString": "#,0"
          },
          {
            "name": "Total Shipped",
            "expression": "SUM(warehouse_daily[shipped])",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "replenishment_recommendations",
        "columns": [
          {
            "name": "warehouse",
            "dataType": "string",
            "sourceColumn": "warehouse",
            "summarizeBy": "none"
          },
          {
            "name": "sku",
            "dataType": "string",
            "sourceColumn": "sku",
            "summarizeBy": "none"
          },
          {
            "name": "as_of_day",
            "dataType": "int64",
            "sourceColumn": "as_of_day",
            "summarizeBy": "none"
          },
          {
            "name": "history_days",
            "dataType": "int64",
            "sourceColumn": "history_days",
            "summarizeBy": "none"
          },
          {
            "name": "mean_daily_demand",
            "dataType": "double",
            "sourceColumn": "mean_daily_demand",
            "summarizeBy": "none"
          },
          {
            "name": "sample_std",
            "dataType": "double",
            "sourceColumn": "sample_std",
            "summarizeBy": "none"
          },
          {
            "name": "wms_stock",
            "dataType": "int64",
            "sourceColumn": "wms_stock",
            "summarizeBy": "none"
          },
          {
            "name": "reorder_point",
            "dataType": "int64",
            "sourceColumn": "reorder_point",
            "summarizeBy": "none"
          },
          {
            "name": "target_stock",
            "dataType": "int64",
            "sourceColumn": "target_stock",
            "summarizeBy": "none"
          },
          {
            "name": "reorder_alert",
            "dataType": "boolean",
            "sourceColumn": "reorder_alert",
            "summarizeBy": "none"
          },
          {
            "name": "recommended_order_qty",
            "dataType": "int64",
            "sourceColumn": "recommended_order_qty",
            "summarizeBy": "none"
          },
          {
            "name": "stock_variance",
            "dataType": "int64",
            "sourceColumn": "stock_variance",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "replenishment_recommendations",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"warehouse\", type text}, {\"sku\", type text}, {\"as_of_day\", Int64.Type}, {\"history_days\", Int64.Type}, {\"mean_daily_demand\", type number}, {\"sample_std\", type number}, {\"wms_stock\", Int64.Type}, {\"reorder_point\", Int64.Type}, {\"target_stock\", Int64.Type}, {\"reorder_alert\", type logical}, {\"recommended_order_qty\", Int64.Type}, {\"stock_variance\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Reorder Alerts",
            "expression": "CALCULATE(COUNTROWS(replenishment_recommendations), replenishment_recommendations[reorder_alert] = TRUE())",
            "formatString": "#,0"
          },
          {
            "name": "Proposed Units",
            "expression": "SUM(replenishment_recommendations[recommended_order_qty])",
            "formatString": "#,0"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"warehouse_daily\", \"replenishment_recommendations\"]"
      }
    ]
  }
}
